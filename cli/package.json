{
  "name": "@racso2609/cli",
  "version": "1.1.0",
    "description": "Terminal client for the agent harness",
  "type": "module",
  "bin": {
    "racso-harness": "./bin/run.mjs"
  },
  "main": "./dist/main.js",
"files": ["dist", "bin", "racso-logo.txt"],
"engines": { "node": ">=22" },
  "packageManager": { "name": "pnpm", "version": "^11.8.0", "onFail": "download" },
  "scripts": {
    "start": "node ./dist/main.js",
    "dev": "tsx ./src/main.ts",
    "build": "tsc && tsc-alias -f",
    "lint": "eslint .",
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@racso2609/core": "workspace:^",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "terminal-image": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
